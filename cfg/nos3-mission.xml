<nos3-mission-cfg>
    <!-- Mission Start Time (J2000 UTC) -->
    <!-- Default time: 814254200.0, 20 Oct 2025 -->
    <start-time>814254200.0</start-time>

    <!-- Ground Software -->
    <!-- This scenario intentionally launches two GDS viewpoints: -->
    <!-- COSMOS = rogue/compromised trusted ground station; YAMCS = legitimate ground station. -->
    <!-- Valid values include cosmos, openc3, fprime, yamcs, or multiple. -->
    <gsw>multiple</gsw>

    <!-- Flight Software -->
    <fsw>cfs</fsw>

    <!-- Scenario -->
    <!-- STF1 is used so 42 RF in-view/occultation behaviour can gate the radio links. -->
    <scenario>STF1</scenario>

    <!-- Minimal constellation research cell: two spacecraft -->
    <number-spacecraft>2</number-spacecraft>

    <!-- Both spacecraft use the mission configuration so radio, CryptoLib-facing -->
    <!-- command paths, ADCS and telemetry needed by the cyber experiment are present. -->
    <sc-1-cfg>spacecraft/sc-mission-config.xml</sc-1-cfg>
    <sc-2-cfg>spacecraft/sc-mission-config.xml</sc-2-cfg>
</nos3-mission-cfg>
